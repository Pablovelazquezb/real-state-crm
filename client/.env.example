# Nova CRM · variables del cliente (build de React)
# Copia como .env (desarrollo) o .env.production (build de producción).

# URL de la API. En desarrollo apunta al servidor local; en producción se sirve
# desde el mismo host, por eso el build usa "/".
REACT_APP_BASE_URL=http://localhost:5001/

# Supabase (solo claves públicas; nunca la secret key)
REACT_APP_SUPABASE_URL=https://tu-proyecto.supabase.co
REACT_APP_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
