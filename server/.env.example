# Nova CRM · variables del servidor
# Copia este archivo como .env y completa los valores reales.

PORT=5001

# Base local (Prospector Facebook, campos personalizados y respaldo del CRM)
DB_URL=mongodb://127.0.0.1:27017
DB=Prolink

# Supabase del CRM
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Claves JWT heredadas (solo si tu proyecto aún las usa)
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Firma de los tokens de sesión
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Prospector Facebook (también se pueden cargar desde la UI del módulo)
APIFY_TOKEN=
GEMINI_API_KEY=
